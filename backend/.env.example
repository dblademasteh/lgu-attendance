# Database — bundled PostgreSQL 16 container (docker-compose publishes localhost:5440, DB lgu_attendance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5440/lgu_attendance?schema=public

# Punch geofence — strict for self-service punches (record + reject outside the
# office radius; location required). DISABLED until OFFICE_LAT/OFFICE_LNG are
# provided together (set them, then `node prisma/seed.js` to persist). These envs
# only provision the seed default — admins override the live config at runtime in
# Settings > Attendance (PATCH /attendance/rule/geofence).
# OFFICE_LAT=14.5995
# OFFICE_LNG=120.9842
# GEOFENCE_RADIUS_M=200     # default 200
# MAX_ACCURACY_M=100        # default 100 (rejects mock/noisy fixes above this)

# Server
PORT=4100
NODE_ENV=development
# WEB_ORIGIN=https://attendance.lgu.gov.ph   # prod origin; localhost dev origins are always allowed

# Auth — JWT access ~15m + refresh rotation
JWT_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string

# ---------------------------------------------------------------------------
# HRMS integration (LGU-HRMS via API)
# ---------------------------------------------------------------------------
# Base URL of the LGU-HRMS API (per HRMS docs/ATTENDANCE_INTEGRATION.md — includes
# the /api/v1 prefix; a bare host gets it appended automatically), e.g. below
HRMS_BASE_URL=http://localhost:4000/api/v1
# API key created in HRMS -> Settings -> Integrations -> API Keys
# (scopes: employees:read for the roster pull, attendance:ingest for forwarding)
HRMS_API_KEY=
# Webhook secret from HRMS -> Settings -> Integrations -> Webhooks (HMAC-SHA256, shown once)
HRMS_WEBHOOK_SECRET=
# Polling fallback: enable the scheduled roster pull with HRMS_SYNC_POLLER=1
HRMS_SYNC_POLLER=0
HRMS_SYNC_INTERVAL_MIN=15
HRMS_TIMEOUT_MS=15000
# Push prefix for HRMS ingestion (POST <base>/punch|bulk|test, x-api-key)
# HRMS_ATTENDANCE_INGEST_BASE=/integrations/attendance
# Set to 1 so collected punches, corrections, and backfills forward to HRMS
HRMS_ATTENDANCE_FORWARD=0
# Optional IP allowlist for inbound webhooks (comma-separated IPs/CIDRs)
INTEGRATION_ALLOWED_IPS=
# Runtime config override: admins can set the base URL, API key, webhook
# secret, poller, and forwarding from Settings > Integration (ADMIN) — saved
# AES-encrypted in the IntegrationConfig table, applied without a restart.
# These envs remain the provisioning fallback until the first save.
# 32-byte hex secret for at-rest encryption (else derived from JWT_SECRET):
# CONFIG_ENCRYPTION_KEY=
